# Benchmark 1D Simple UOX assembly
# ---------------------------------------------------------------------------
#

# Dimension of the problem (1, 2 or 3)
set Dimension            = 1

# Number of eigenvalues required
set N_Eigenvalues        = 1

# "True/false - Compute the time-dependent computation
set Transient            = true

# True/false - Output static values to noise
set Output_To_Noise      = true

# REACTOR and MESH DEFINITION
# Finite element degree
set FE_Degree            = 2

# Transport Approximation used (Diffusion | SPN | Full_SPN)
set Transport_Appr       = Diffusion

 
# Number of global refinements 
set N_Refinements        = 0

# Number of cells per dimension
set Mesh_Size           = 138

# Pitch of the cells    waterStrip   -------------------------  Pin 1      -------------------------   -------------------------  Pin 2      -------------------------   -------------------------  Pin 3      -------------------------   -------------------------  Pin 4      -------------------------   -------------------------  Pin 5      -------------------------   -------------------------  Pin 6      -------------------------   -------------------------  Pin 7      -------------------------   -------------------------  Pin 8      -------------------------   -------------------------  Pin 9      -------------------------   -------------------------  Pin 10     -------------------------   -------------------------  Pin 11     -------------------------   -------------------------  Pin 12     -------------------------   -------------------------  Pin 13     -------------------------   -------------------------  Pin 14     -------------------------   -------------------------  Pin 15     -------------------------   -------------------------  Pin 16     -------------------------   -------------------------  Pin 17     -------------------------  waterstrip
set Cell_Pitch_x        = 0.08       0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.13215 0.13215 0.18285 0.18285 0.18285 0.18285 0.13215 0.13215   0.08

# Boundary Conditopns (LEFT RIGHT DOWN UP)   (0 = ZeroFlux) (1 ZeroCurrent) (2 Vaccum) (3 Albedo) 
set Boundary_Conditions = 1 1

# OUTOPTIONS
# True/false - Make a .vtk file with the output
set Output_Flag         = false

# True/false - Print the grid in .eps
set Print_Grid_Flag     = false

# Number of Refinements per cell in the .vtk output
set Out_Refinements     = 0

# Filename where will be written the output
set Output_Filename     = 1D_UOX_FA/time_domain/1D_UOX_FA_ex2_dif_td.out

#
## TIME PARAMETERS
set Distributed_Time_Scheme        = Semi-Implicit-Exponential 

# Delta time of the iteration
set Time_Delta          = 1e-2
set Time_End            = 3.0

## Every this number of steps we will create a .vtk file
 set Out_Interval        = 1
 
#
# CROSS SECTION
# Filename where it is stored the material cross section
set XSECS_Filename      = 1D_UOX_FA/1D_UOX_FA_ex2_td.xsec

#
## VIBRATION
set Type_Perturbation     = Single_Material
set Perturbation_Function = 1D_UOX_FA
set Material_Changing     = 3

# Frecuency of the vibration in Hz
set Frequency             = 1.0

#
# SOLVER 
# Solver Type (power_it | bifpam | slepc_2g | slepc_7g | ks | gd | newton)
set Solver_Type         = bifpam
