# TEST 3D Time -- 1 Group -- Axial power for the flux weighting method
# ---------------------------------------------------------------------------
# Homogeneous column of 4 planes of 20 x 20 x 25 cm, zero current on the
# sides and vacuum at both ends, with a small sinusoidal change of sigma_a.
# The flux weighting method of the rods takes the axial power of the last
# time step (no rod moves here).

# Dimension of the problem (1, 2 or 3)
set Dimension            = 3

# Number of eigenvalues required
set N_Eigenvalues        = 1

# Transport Approximation used (Diffusion | SPN )
set Transport_Appr       = Diffusion

# Energy groups
set Energy_Groups        = 1

# REACTOR and MESH DEFINITION
# Finite element degree
set FE_Degree            = 1

# Number of global refinements
set N_Refinements        = 0

# Number of cells per dimension
set Mesh_Size            = 1 1 4

# Pitch of the cells
set Cell_Pitch_x         = 20.0
set Cell_Pitch_y         = 20.0
set Cell_Pitch_z         = 4* 25.0

# Boundary Conditions (LEFT RIGHT TOP BOTTOM UP DOWN) (0 ZeroFlux) (1 ZeroCurrent) (2 Vacuum)
set Boundary_Conditions  = 1 1 1 1 2 2

# OUT OPTIONS
# True/false - Make a .vtk file with the output
set Output_Flag          = false

# True/false - Print the grid in .eps
set Print_Grid_Flag      = false

# Solver tolerances
set EPS_Tolerance        = 1e-10
set KSP_Tolerance        = 1e-12

# Input types
# XS type file defined (Femfusion | XSEC | XML | Valkin | Coresim)
set XSEC_Type            = XSEC
set XSECS_Filename       = test/3D_time_power_assembly/1g.xsec

# Filename where will be written the output.
set Output_Filename      = test/3D_time_power_assembly/3D_diffusion_fluxwei.out

# TIME PARAMETERS
set Transient            = true
set Time_Delta           = 0.01
set Time_End             = 0.0525

# PERTURBATION
set Type_Perturbation    = Single_Material
set Perturbation_Function = Sinus
set XS_Name              = sigma_a
set Group_Changing       = 1
set Material_Changing    = 1
set Amplitude            = 1.0e-4
set Frequency            = 1.0

# Rod cusping treatment (volhom | fluxwei)
set Rod_Cusping_Method   = fluxwei
