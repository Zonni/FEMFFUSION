# TEST 1D Noise -- 1 Group, XML materials with one precursor family and ChiD
# Uniform removal noise on a homogeneous slab with zero current faces.
# noise_no_chid.prm is the same problem without ChiD, so ChiD defaults to Chi
# and both must give the same delta_phi.
# ---------------------------------------------------------------------------
#

# Dimension of the problem (1, 2 or 3)
set Dimension            = 1

# Number of eigenvalues required
set N_Eigenvalues        = 1

# Transport Approximation used (Diffusion | SPN )
set Transport_Appr       = Diffusion

# Energy groups
set Energy_Groups        = 1

# True/false - Activate Frequency Domain Noise Calculation
set Noise_Calculation    = true

# REACTOR and MESH DEFINITION
# Finite element degree
set FE_Degree            = 2

# Number of global refinements
set N_Refinements        = 0

# Number of cells per dimension
set Mesh_Size            = 8

# Pitch of the cells in x dimension
set Cell_Pitch_x         = 8* 25.0

# Boundary Conditions (LEFT RIGHT)   (0 ZeroFlux) (1 ZeroCurrent) (2 Vacuum)
set Boundary_Conditions  = 1 1

# Solver tolerances (KSP_Noise_Tolerance is absolute: 1e-12 x the system_rhs norm, 6.547)
set EPS_Tolerance        = 1e-10
set KSP_Tolerance        = 1e-12
set KSP_Noise_Tolerance  = 6.5e-12

# OUT OPTIONS
# True/false - Make a .vtk file with the output
set Output_Flag          = false

# Input types
# XS type file defined (Femfusion | XSEC | XML | Valkin | Coresim)
set XSEC_Type            = XML
set XSECS_Filename       = test/1D_xml_noise_chid/xs_chid.xml

# Filename where it is stored the pertubation data in form of delta xs.
set DS_Filename          = test/1D_xml_noise_chid/dxs.xml

# Frequency of the perturbation
set DYN_Filename         = test/1D_xml_noise_chid/dyn.prm

# Filename where will be written the output.
set Output_Filename      = test/1D_xml_noise_chid/noise_chid.out
