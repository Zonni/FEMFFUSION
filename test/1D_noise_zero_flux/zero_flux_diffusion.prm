# TEST 1D Noise -- 1 Group, zero flux on both faces
# ---------------------------------------------------------------------------
# The noise is dphi = c phi with
# c = -dSigma_r / (i w/v + (nuSf/k) beta i w/(lambda + i w)), k the computed
# eigenvalue, so the l2 norm of delta_phi is |c| ||phi||.
#

# Dimension of the problem (1, 2 or 3)
set Dimension            = 1

# Number of eigenvalues required
set N_Eigenvalues        = 1

# Transport Approximation used (Diffusion | SPN )
set Transport_Appr       = Diffusion

# Energy groups
set Energy_Groups        = 1

# True/false - Activate Frequency Domain Noise Calculation
set Noise_Calculation    = true

# REACTOR and MESH DEFINITION
# Finite element degree
set FE_Degree            = 2

# Number of global refinements
set N_Refinements        = 0

# Number of cells per dimension
set Mesh_Size            = 8

# Pitch of the cells in x dimension
set Cell_Pitch_x         = 8* 25.0

# Boundary Conditopns (LEFT RIGHT DOWN UP)   (0 ZeroFlux) (1 ZeroCurrent) (2 Vaccum) (3 Albedo)
set Boundary_Conditions  = 0 0

# OUT OPTIONS
# True/false - Make a .vtk file with the output
set Output_Flag          = false

# True/false - Print the grid in .eps
set Print_Grid_Flag      = false

# Input types
# XS type file defined (Femfusion | XSEC | XML | Valkin | Coresim)
set XSEC_Type            = XSEC
set XSECS_Filename       = test/1D_noise_zero_flux/1g.xsec

# Filename where it is stored the pertubation data in form of delta xs.
set DS_Filename          = test/1D_noise_zero_flux/1g.dxs

#
set DYN_Filename         = test/1D_noise_zero_flux/1g.dyn.prm

# Filename where will be written the output.
set Output_Filename      = test/1D_noise_zero_flux/zero_flux_diffusion.out

set EPS_Tolerance        = 1e-10
set KSP_Tolerance        = 1e-12

# Absolute tolerance of the noise solve: 1e-12 x the system_rhs norm (7.24646)
set KSP_Noise_Tolerance  = 7.24646e-12
