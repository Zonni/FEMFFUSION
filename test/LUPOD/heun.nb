Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Parameters", " ", "from", " ", "the", " ", "paper"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"c1", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"c2", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"c", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a", "=", "2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d", "=", "6"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "solution", " ", "u", 
     RowBox[{"(", 
      RowBox[{"x", ",", "t"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "z", "}"}], ",", 
      RowBox[{
       RowBox[{"z", "=", 
        RowBox[{"x", "-", 
         RowBox[{"c", " ", "t"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "c"}], " ", 
          RowBox[{"z", "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "d"}], ")"}]}]}], "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"c1", " ", "*", 
           RowBox[{"MathieuC", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               RowBox[{"c", "^", "2"}]}], "/", 
              RowBox[{"d", "^", "2"}]}], ",", 
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              RowBox[{"a", "/", "d"}]}], ",", 
             RowBox[{"z", "/", "2"}]}], "]"}]}], "+", 
          RowBox[{"c2", " ", "*", 
           RowBox[{"MathieuS", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               RowBox[{"c", "^", "2"}]}], "/", 
              RowBox[{"d", "^", "2"}]}], ",", 
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              RowBox[{"a", "/", "d"}]}], ",", 
             RowBox[{"z", "/", "2"}]}], "]"}]}]}], ")"}]}]}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"u2", "[", 
     RowBox[{"x_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "z", "}"}], ",", 
      RowBox[{
       RowBox[{"z", "=", 
        RowBox[{"x", "-", 
         RowBox[{"c", " ", "t"}]}]}], ";", "\[IndentingNewLine]", " ", 
       RowBox[{"MathieuS", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"c", "^", "2"}]}], "/", 
          RowBox[{"d", "^", "2"}]}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{"a", "/", "d"}]}], ",", 
         RowBox[{"z", "/", "2"}]}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "3", "d", " ", "plot", " ", "analogous", " ", "to", " ", "the", " ", 
       "article"}], "\[CloseCurlyQuote]"}], "s", " ", "Figure", " ", "4"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"u2", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "40"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotPoints", "->", "70"}], ",", 
     RowBox[{"MaxRecursion", "->", "2"}], ",", 
     RowBox[{"Mesh", "->", "None"}], ",", 
     RowBox[{"ColorFunction", "->", "\"\<Rainbow\>\""}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<t\>\"", ",", "\"\<u(x,t)\>\""}], 
       "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "Large"}], ",", 
     RowBox[{"BoxRatios", "->", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "0.6"}], "}"}]}], ",", 
     RowBox[{"Lighting", "->", "\"\<Neutral\>\""}]}], "]"}]}]}]], "Input",
