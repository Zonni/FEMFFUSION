# 1D two-group slab of one material with zero-current faces, diffusion
# transient. At t > 0 material 1 becomes material 2 (Step_Change_Material),
# whose group-2 removal is larger by 1.0e-4 1/cm. The flux stays flat, so
# the power follows the point kinetics of the two materials.
set Dimension                = 1
set Transport_Appr           = Diffusion
set N_Eigenvalues            = 1
set Energy_Groups            = 2
set Geometry_Type            = Rectangular
set FE_Degree                = 2
set N_Refinements            = 0
set Mesh_Size                = 5
set Cell_Pitch_x             = 5* 2.0
set Boundary_Conditions      = 1 1
set Output_Flag              = false
set Print_Grid_Flag          = false
set XSEC_Type                = XSEC
set XSECS_Filename           = test/1D_time_step_change/1D_time.xsec
set Output_Filename          = test/1D_time_step_change/1D_time_step.out
set EPS_Tolerance            = 1e-12
set KSP_Tolerance            = 1e-12

# Time parameters
set Transient                = true
set Distributed_Time_Scheme  = Implicit-Exponential
set Time_Delta               = 0.01
set Time_End                 = 0.1025
set Type_Perturbation        = Step_Change_Material
set Material_Changing        = 1 2
