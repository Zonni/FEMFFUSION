# TEST 1D Time -- 2 Groups -- Power per assembly after a stationary transient
# ---------------------------------------------------------------------------
# Homogeneous slab of 8 cells of 25 cm with vacuum at both ends, and a
# perturbation of amplitude zero: the power stays at its static value.

# Dimension of the problem (1, 2 or 3)
set Dimension            = 1

# Number of eigenvalues required
set N_Eigenvalues        = 1

# Transport Approximation used (Diffusion | SPN )
set Transport_Appr       = Diffusion

# Energy groups
set Energy_Groups        = 2

# REACTOR and MESH DEFINITION
# Finite element degree
set FE_Degree            = 2

# Number of global refinements
set N_Refinements        = 0

# Number of cells per dimension
set Mesh_Size            = 8

# Pitch of the cells in x dimension
set Cell_Pitch_x         = 8* 25.0

# Boundary Conditions (LEFT RIGHT)   (0 ZeroFlux) (1 ZeroCurrent) (2 Vacuum)
set Boundary_Conditions  = 2 2

# OUT OPTIONS
# True/false - Make a .vtk file with the output
set Output_Flag          = false

# True/false - Print the grid in .eps
set Print_Grid_Flag      = false

# Solver tolerances
set EPS_Tolerance        = 1e-10
set KSP_Tolerance        = 1e-12

# Input types
# XS type file defined (Femfusion | XSEC | XS2G | XML | Valkin | Coresim)
set XSEC_Type            = XS2G
set XSECS_Filename       = test/1D_time_power_assembly/2g.xsec

# Filename where will be written the output.
set Output_Filename      = test/1D_time_power_assembly/1D_diffusion.out

# TIME PARAMETERS
set Transient            = true
set Time_Delta           = 0.01
set Time_End             = 0.0525

# PERTURBATION
# Sinus change of every cross section of material 1 (Group_Changing 0: all
# groups); all amplitudes are zero.
set Type_Perturbation    = Single_Material
set Perturbation_Function = Sinus
set XS_Name              = all
set Group_Changing       = 0
set Material_Changing    = 1
set Amplitudes           = 0 0 0 0 0 0 0 0
set Frequency            = 1.0
