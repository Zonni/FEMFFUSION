# Reactor 1D Full SP1, 2 groups, 40 cm, zero current, refined twice
# ---------------------------------------------------------------------------

# Dimension of the problem (1, 2 or 3)
set Dimension            = 1

# Number of eigenvalues
set N_Eigenvalues        = 1

# Transport Approximation used (Diffusion | SPN | Full_SPN)
set Transport_Appr       = Full_SPN

# Set N of the SPN equations used (1, 3 or 5)
set N_SPN                = 1

# Set the number of neutron energy groups defined in the calculation
set Energy_Groups        = 2

#
# REACTOR DEFINITION
# Finite element Degree
set FE_Degree            = 1

# Number of global refinements
set N_Refinements        = 2

# Number of cells per dimension
set Mesh_Size            = 4

# Pitch of the cells in x dimension
set Cell_Pitch_x         = 4* 10.0

# Boundary Conditions  (0 ZeroFlux) (1 ZeroCurrent) (2 Vaccum)
#                       LEFT RIGHT
set Boundary_Conditions  = 1 1

#
# OUTPUT OPTIONS
# Filename where will be written the output
set Output_Filename      = test/1D_full_spn_assembly_average/1D_fsp1_2g_zerocurrent.out

# True/false - Make a .vtk file with the output
set Output_Flag          = false

# True/false - Print the grid in .eps
set Print_Grid_Flag      = false

#
# CROSS SECTIONS
# Filename where it is stored the material cross section
set XSECS_Filename       = test/1D_full_spn_assembly_average/2g.xsec

# XS type file defined (XS2G | XSEC | XML | Valkin)
set XSEC_Type            = XS2G

#
# SOLVER
set EPS_Tolerance        = 1e-10
set KSP_Tolerance        = 1e-12
